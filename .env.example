# Copy this file to .env before adding real values. Doon lang ilagay ang private keys.
# Use a dedicated Supabase project for Bright Smile. Huwag gamitin ang keys ng ibang project.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# This key is needed for the contact inbox, not basic login. Python lang ang puwedeng gumamit.
SUPABASE_SECRET_KEY=
# Create a Cal.com API key for this website. Nasa Python lang ito, hindi sa browser.
CAL_API_KEY=
# Paste numeric event type IDs, not booking links. Numbers lang ang kailangan dito.
# Match Cal.com durations: checkup 30, cleaning 30, filling 60, extraction 60, followup 30 minutes.
# Set each event to Asia/Manila and the clinic address. Pareho dapat ang schedule at lugar.
CAL_EVENT_CHECKUP=
CAL_EVENT_CLEANING=
CAL_EVENT_FILLING=
CAL_EVENT_EXTRACTION=
CAL_EVENT_FOLLOWUP=
# Leave these false while setting up keys and tables. Preview muna hanggang ma-check ang connection.
LIVE_BOOKING_ENABLED=false
CONTACT_ENABLED=false
# Production URL: https://bsmile.vercel.app. Local URL muna habang nasa computer.
SITE_URL=http://127.0.0.1:8000
CLINIC_ADDRESS=Rizal Street, San Isidro
CLINIC_DENTIST=Dr. A. Reyes
CLINIC_PHONE=
CLINIC_EMAIL=
# Demo accounts use separate practice events. Hindi sila totoong clinic appointments.
CAL_DEMO_EVENT_CHECKUP=
CAL_DEMO_EVENT_CLEANING=
CAL_DEMO_EVENT_FILLING=
CAL_DEMO_EVENT_EXTRACTION=
CAL_DEMO_EVENT_FOLLOWUP=
